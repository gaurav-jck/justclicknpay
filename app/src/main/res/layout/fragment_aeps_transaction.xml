<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical">

    <include
        android:id="@+id/topView"
        layout="@layout/top_view"
        />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="AEPS-2"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="@dimen/margin_5dp"
        android:textSize="@dimen/text_size_14sp"
        android:textColor="@color/lightBlueColor"
        />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        tools:context=".jctPayment.Cash_Deposit_Activity"
        >

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:layout_marginLeft="20dp"
            android:layout_marginRight="20dp"
            android:layout_marginTop="20dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/add_beneficiary_side_margin"
                android:layout_marginRight="@dimen/add_beneficiary_side_margin"
                android:layout_marginTop="@dimen/medium_margin"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/aeps1Tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:background="@drawable/blue_rect_button_background"
                    android:paddingBottom="@dimen/small_margin"
                    android:paddingLeft="@dimen/very_large_margin"
                    android:paddingRight="@dimen/very_large_margin"
                    android:paddingTop="@dimen/small_margin"
                    android:text=" AEPS 1 "
                    android:textSize="@dimen/money_transfer_button_text_size"
                    android:textColor="@color/color_white" />

                <TextView
                    android:id="@+id/aeps2Tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:background="@drawable/money_receiver_border_rect_corner"
                    android:paddingBottom="@dimen/small_margin"
                    android:paddingLeft="@dimen/very_large_margin"
                    android:paddingRight="@dimen/very_large_margin"
                    android:paddingTop="@dimen/small_margin"
                    android:text=" AEPS 2 "
                    android:textSize="@dimen/money_transfer_button_text_size"
                    android:textColor="@color/dark_blue_color" />

                <TextView
                    android:id="@+id/aeps3Tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:background="@drawable/money_receiver_border_rect_corner"
                    android:paddingBottom="@dimen/small_margin"
                    android:paddingLeft="@dimen/very_large_margin"
                    android:paddingRight="@dimen/very_large_margin"
                    android:paddingTop="@dimen/small_margin"
                    android:text=" AEPS 3 "
                    android:textSize="@dimen/money_transfer_button_text_size"
                    android:textColor="@color/dark_blue_color" />

            </LinearLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/bankInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColorHint="@color/colorHint"
                android:layout_marginTop="@dimen/size_20dp"
                app:layout_constraintEnd_toEndOf="parent">
                <AutoCompleteTextView
                    android:id="@+id/autoBank"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="8"
                    android:layout_gravity="center_vertical"
                    android:background="@color/transparent"
                    android:padding="@dimen/margin_5dp"
                    android:layout_margin="@dimen/margin_2dp"
                    android:textColor="@color/black_text_color"
                    android:textSize="@dimen/text_size_16sp"
                    android:hint="Please select bank name"
                    android:text=""
                    android:digits="@string/alphaNumericSpace_editText_digits"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:maxLength="100"
                    android:inputType="textPersonName"
                    />

            </com.google.android.material.textfield.TextInputLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/margin_2dp"
                android:layout_marginTop="@dimen/margin_3dp"
                android:layout_marginBottom="@dimen/margin_5dp"
                android:layout_marginLeft="@dimen/margin_5dp"
                android:layout_marginRight="@dimen/margin_5dp"
                android:background="@color/gray_color"
                android:visibility="visible"/>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/aadhar_no"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_10dp"
                android:hint="Please enter your Aadhar number"
                android:textColorHint="@color/colorHint">

                <EditText
                    android:id="@+id/aadharEdt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_weight="6"
                    android:digits="@string/mobile_digit"
                    android:maxLines="1"
                    android:maxLength="12"
                    android:inputType="number"
                    android:singleLine="true"
                    android:textColor="@color/black_text_color"
                    android:textSize="@dimen/text_size_15sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/mobile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_10dp"
                android:hint="Please enter your mobile number"
                android:textColorHint="@color/colorHint">

                <EditText
                    android:id="@+id/mobileEdt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_weight="6"
                    android:digits="@string/mobile_digit"
                    android:maxLines="1"
                    android:maxLength="10"
                    android:inputType="number"
                    android:singleLine="true"
                    android:textColor="@color/black_text_color"
                    android:textSize="@dimen/text_size_15sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/amount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_10dp"
                android:hint="Please enter amount"
                android:textColorHint="@color/colorHint">

                <EditText
                    android:id="@+id/amountEdt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_weight="6"
                    android:digits="@string/mobile_digit"
                    android:maxLines="1"
                    android:maxLength="5"
                    android:inputType="number"
                    android:singleLine="true"
                    android:textColor="@color/black_text_color"
                    android:textSize="@dimen/text_size_15sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Select Device Type"
                android:textColor="@color/app_blue_color"
                android:layout_marginTop="@dimen/size_15dp"
                android:layout_marginLeft="@dimen/margin_2dp"
                android:textSize="@dimen/text_size_14sp" />

            <Spinner
                android:id="@+id/spinnerDeviceType"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_10dp"
                android:layout_marginLeft="@dimen/margin_5dp"
                android:layout_marginRight="@dimen/margin_5dp"
                />

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/margin_2dp"
                android:layout_margin="@dimen/margin_5dp"
                android:background="@color/gray_color"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_40dp"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <Button
                    android:id="@+id/btnCapture"
                    android:layout_width="match_parent"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="Capture fingerprint"
                    android:textSize="@dimen/text_size_16sp"
                    android:textColor="@color/colorWhite"
                    android:background="@drawable/app_blue_round_button_background"
                    />

                <Button
                    android:id="@+id/btnCaptureFace"
                    android:layout_width="match_parent"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="Capture Face Data"
                    android:textSize="@dimen/text_size_16sp"
                    android:textColor="@color/colorWhite"
                    android:layout_marginTop="@dimen/margin_10dp"
                    android:background="@drawable/app_blue_round_button_background"
                    />

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>