<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:card_view="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical">

    <include
        android:id="@+id/topView"
        layout="@layout/top_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.cardview.widget.CardView
            android:id="@+id/card_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_alignParentLeft="true"
            android:layout_alignParentStart="true"
            android:layout_alignParentTop="true"
            android:layout_margin="@dimen/small_margin"
            card_view:cardBackgroundColor="@color/cardMobileBackground"
            card_view:cardCornerRadius="4dp">


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginBottom="@dimen/very_small_margin"
                android:layout_marginLeft="@dimen/small_margin"
                android:layout_marginRight="@dimen/small_margin"
                android:layout_marginTop="@dimen/small_margin"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/person_detail_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:padding="@dimen/small_margin"
                    android:text="BILL DETAIL"
                    android:textColor="@color/color_black"
                    android:textSize="@dimen/text_size_16sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/add_beneficiary_side_margin"
                    android:layout_marginRight="@dimen/add_beneficiary_side_margin"
                    android:layout_marginTop="@dimen/small_margin"
                    android:background="@drawable/money_receiver_border_rect_corner"
                    android:gravity="center"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/mr_tv"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@color/app_blue_color"
                        android:gravity="center"
                        android:padding="@dimen/small_margin"
                        android:text="MR"
                        android:textColor="@color/color_white" />

                    <View
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:background="@color/dark_blue_color" />


                    <TextView
                        android:id="@+id/ms_tv"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:padding="@dimen/small_margin"
                        android:text="MS"
                        android:textColor="@color/app_blue_color" />

                    <View
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:background="@color/dark_blue_color" />

                    <TextView
                        android:id="@+id/mrs_tv"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:padding="@dimen/small_margin"
                        android:text="MRS"
                        android:textColor="@color/app_blue_color" />
                </LinearLayout>


                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/param1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/add_beneficiary_side_margin"
                    android:layout_marginRight="@dimen/add_beneficiary_side_margin"
                    android:layout_marginTop="@dimen/small_margin">

                    <EditText
                        android:id="@+id/nameEdt"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:layout_weight="6"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:enabled="false"
                        android:focusable="false"
                        android:hint="Customer Name"
                        android:textColor="@color/app_blue_color"
                        android:textColorHint="@color/registration_hint_color"
                        android:textSize="@dimen/money_transfer_input_text_size" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/param2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/add_beneficiary_side_margin"
                    android:layout_marginRight="@dimen/add_beneficiary_side_margin"
                    android:layout_marginTop="@dimen/small_margin">

                    <EditText
                        android:id="@+id/billNoEdt"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:layout_weight="6"
                        android:maxLines="1"
                        android:maxLength="@integer/bankAccountMaxLength"
                        android:inputType="text"
                        android:singleLine="true"
                        android:enabled="false"
                        android:focusable="false"
                        android:hint="Customer Bill Number"
                        android:textColor="@color/app_blue_color"
                        android:textColorHint="@color/registration_hint_color"
                        android:textSize="@dimen/money_transfer_input_text_size" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/param3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/add_beneficiary_side_margin"
                    android:layout_marginRight="@dimen/add_beneficiary_side_margin"
                    android:layout_marginTop="@dimen/small_margin">

                    <EditText
                        android:id="@+id/dueDateEdt"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:layout_weight="6"
                        android:maxLines="1"
                        android:maxLength="@integer/bankAccountMaxLength"
                        android:inputType="text"
                        android:singleLine="true"
                        android:enabled="false"
                        android:focusable="false"
                        android:hint="Due Date"
                        android:textColor="@color/app_blue_color"
                        android:textColorHint="@color/registration_hint_color"
                        android:textSize="@dimen/money_transfer_input_text_size" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/param4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/add_beneficiary_side_margin"
                    android:layout_marginRight="@dimen/add_beneficiary_side_margin"
                    android:layout_marginTop="@dimen/small_margin">

                    <EditText
                        android:id="@+id/amountEdt"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:layout_weight="6"
                        android:maxLines="1"
                        android:maxLength="@integer/bankAccountMaxLength"
                        android:inputType="text"
                        android:singleLine="true"
                        android:enabled="false"
                        android:focusable="false"
                        android:hint="Bill amount"
                        android:textColor="@color/app_blue_color"
                        android:textColorHint="@color/registration_hint_color"
                        android:textSize="@dimen/money_transfer_input_text_size" />
                </com.google.android.material.textfield.TextInputLayout>


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="bottom"
                    android:orientation="horizontal"
                    android:layout_marginTop="@dimen/large_margin">

                    <TextView
                        android:id="@+id/cancelTv"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginLeft="@dimen/add_beneficiary_side_margin"
                        android:layout_marginRight="@dimen/add_beneficiary_side_margin"
                        android:background="@drawable/app_red_round5_button_background"
                        android:gravity="center"
                        android:paddingLeft="@dimen/small_margin"
                        android:paddingRight="@dimen/small_margin"
                        android:paddingTop="@dimen/medium_margin"
                        android:paddingBottom="@dimen/medium_margin"
                        android:text="Cancel"
                        android:maxLines="1"
                        android:textSize="@dimen/text_size_16sp"
                        android:textColor="@color/color_white" />

                    <TextView
                        android:id="@+id/fetchbillTv"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginLeft="@dimen/add_beneficiary_side_margin"
                        android:layout_marginRight="@dimen/add_beneficiary_side_margin"
                        android:background="@drawable/app_blue_round_button_background"
                        android:gravity="center"
                        android:paddingLeft="@dimen/small_margin"
                        android:paddingRight="@dimen/small_margin"
                        android:paddingTop="@dimen/medium_margin"
                        android:paddingBottom="@dimen/medium_margin"
                        android:text="Pay Bill"
                        android:maxLines="1"
                        android:visibility="visible"
                        android:textSize="@dimen/text_size_16sp"
                        android:textColor="@color/color_white" />

                </LinearLayout>

            </LinearLayout>

        </androidx.cardview.widget.CardView>
    </ScrollView>
</LinearLayout>
