<?xml version="1.0" encoding="utf-8"?>
<LinearLayout android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical">

    <include
        android:id="@+id/topView"
        layout="@layout/top_view"
        />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="25dp"
        android:layout_marginLeft="@dimen/margin_10dp"
        android:layout_marginRight="@dimen/margin_10dp"
        android:text="@string/dash_board_services"
        android:background="@color/colorAEPSDashboardBlue"
        android:padding="@dimen/small_margin"
        android:textSize="17sp"
        android:textStyle="bold"
        android:textColor="@color/colorText" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_20dp"
        android:layout_marginLeft="@dimen/margin_10dp"
        android:layout_marginRight="@dimen/margin_10dp"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/cashWithdrawLin"
            android:layout_width="0dp"
            android:layout_height="@dimen/dashboard_icon_w"
            android:layout_weight="1"
            android:background="@drawable/aeps_border"
            android:gravity="center"
            android:orientation="horizontal">
            <ImageView
                android:layout_width="@dimen/aeps_icon_w"
                android:layout_height="@dimen/aeps_icon_h"
                app:srcCompat="@drawable/ic_cash_payout"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cash\nWithdraw"
                android:textColor="@color/app_blue_color_light"
                android:textSize="@dimen/dashboard_icon_name_size"
                android:textStyle="bold"
                android:layout_marginLeft="@dimen/margin_10dp"
                android:minLines="2"
                android:gravity="center_horizontal"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/balanceEnqLin"
            android:layout_width="0dp"
            android:layout_height="@dimen/dashboard_icon_w"
            android:layout_weight="1"
            android:background="@drawable/aeps_border"
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_marginLeft="@dimen/large_margin">
            <ImageView
                android:layout_width="@dimen/aeps_icon_w"
                android:layout_height="@dimen/aeps_icon_h"
                app:srcCompat="@drawable/ic_wallet_balance"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" Balance \nEnquiry"
                android:textColor="@color/app_blue_color_light"
                android:textSize="@dimen/dashboard_icon_name_size"
                android:textStyle="bold"
                android:layout_marginLeft="@dimen/margin_10dp"
                android:minLines="2"
                android:gravity="center_horizontal"/>
        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_20dp"
        android:layout_marginLeft="@dimen/margin_10dp"
        android:layout_marginRight="@dimen/margin_10dp"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/adharPayLin"
            android:layout_width="0dp"
            android:layout_height="@dimen/dashboard_icon_w"
            android:layout_weight="1"
            android:background="@drawable/aeps_border"
            android:gravity="center"
            android:orientation="horizontal">
            <ImageView
                android:layout_width="@dimen/aeps_icon_w"
                android:layout_height="@dimen/aeps_icon_h"
                app:srcCompat="@drawable/ic_cash_payout"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" Aadhar \nPay"
                android:textColor="@color/app_blue_color_light"
                android:textSize="@dimen/dashboard_icon_name_size"
                android:textStyle="bold"
                android:layout_marginLeft="@dimen/margin_10dp"
                android:minLines="2"
                android:gravity="center_horizontal"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/miniStmtLin"
            android:layout_width="0dp"
            android:layout_height="@dimen/dashboard_icon_w"
            android:layout_weight="1"
            android:background="@drawable/aeps_border"
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_marginLeft="@dimen/large_margin">
            <ImageView
                android:layout_width="@dimen/aeps_icon_w"
                android:layout_height="@dimen/aeps_icon_h"
                app:srcCompat="@drawable/ic_wallet_balance"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mini\nStatement"
                android:textColor="@color/app_blue_color_light"
                android:textSize="@dimen/dashboard_icon_name_size"
                android:textStyle="bold"
                android:layout_marginLeft="@dimen/margin_10dp"
                android:minLines="2"
                android:gravity="center_horizontal"/>
        </LinearLayout>

    </LinearLayout>
</LinearLayout>