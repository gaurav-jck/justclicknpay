<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:card_view="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical">

    <RelativeLayout
        android:id="@+id/rel_top"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/colorPrimary"
        android:padding="@dimen/small_margin">

        <ImageView
            android:id="@+id/back_arrow"
            android:layout_width="@dimen/back_arrow_size"
            android:layout_height="@dimen/back_arrow_size"
            app:srcCompat="@drawable/arrow_left_back"
            android:padding="@dimen/very_small_margin"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sales Agent Credit"
            android:textSize="@dimen/title_text_size"
            android:textColor="@color/color_white"
            android:layout_centerInParent="true"/>

    </RelativeLayout>

    <androidx.cardview.widget.CardView
        android:id="@+id/card_view_agent_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentLeft="true"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:layout_margin="@dimen/small_margin"
        card_view:cardBackgroundColor="@color/cardMobileBackground"
        card_view:cardCornerRadius="4dp">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginBottom="@dimen/very_small_margin"
            android:layout_marginLeft="@dimen/small_margin"
            android:layout_marginRight="@dimen/small_margin"
            android:layout_marginTop="@dimen/small_margin"
            android:orientation="vertical">

            <TextView
                android:id="@+id/agent_detail_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:padding="@dimen/small_margin"
                android:text="Sales Person Agency List"
                android:textColor="@color/color_black"
                android:textSize="@dimen/text_size_16sp"
                android:textStyle="bold" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/atv_bank_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/medium_margin"
                >
                <AutoCompleteTextView
                    android:id="@+id/atv_agent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:backgroundTint="@color/text_light_gray"
                    android:textColorHint="@color/text_light_gray"
                    android:inputType="text"
                    android:paddingLeft="6dp"
                    android:layout_marginTop="@dimen/small_margin"
                    android:layout_marginLeft="@dimen/add_beneficiary_side_margin"
                    android:layout_marginRight="@dimen/add_beneficiary_side_margin"
                    android:text=""
                    android:textSize="@dimen/money_transfer_input_text_size"
                    android:hint="Agent Name"
                    android:textColor="@color/app_blue_color"
                    android:digits="@string/bank_name_digit"
                    android:textCursorDrawable="@color/white"
                    android:completionThreshold="1"/>
            </com.google.android.material.textfield.TextInputLayout>

        </LinearLayout>

    </androidx.cardview.widget.CardView>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.cardview.widget.CardView
            android:id="@+id/card_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_alignParentLeft="true"
            android:layout_alignParentStart="true"
            android:layout_alignParentTop="true"
            android:layout_margin="@dimen/small_margin"
            card_view:cardBackgroundColor="@color/cardMobileBackground"
            card_view:cardCornerRadius="4dp">


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginBottom="@dimen/very_small_margin"
                android:layout_marginLeft="@dimen/small_margin"
                android:layout_marginRight="@dimen/small_margin"
                android:layout_marginTop="@dimen/small_margin"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/detail_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:padding="@dimen/small_margin"
                    android:text="Credit Details"
                    android:textColor="@color/color_black"
                    android:textSize="@dimen/text_size_16sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="@color/filterBackground"
                    android:gravity="center_vertical"
                    android:layout_marginLeft="@dimen/add_beneficiary_side_margin"
                    android:layout_marginRight="@dimen/add_beneficiary_side_margin"
                    android:layout_marginTop="@dimen/medium_margin">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Sales Person"
                        android:textColor="@color/black_text_color"
                        android:layout_gravity="center_vertical"
                        android:background="@color/transparent"
                        android:textSize="@dimen/text_size_15sp"
                        android:paddingLeft="@dimen/medium_margin"
                        android:paddingRight="@dimen/medium_margin"
                        />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight=".1"
                        android:text=":"
                        android:textColor="@color/dark_blue_color"
                        android:background="@color/transparent"
                        android:fontFamily="@font/museo_regular"
                        android:textSize="@dimen/list_view_name_field_text_size"
                        />

                    <TextView
                        android:id="@+id/salesPersonTv"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.3"
                        android:layout_gravity="center_vertical"
                        android:textColor="@color/dark_blue_color"
                        android:textSize="@dimen/text_size_16sp"
                        android:padding="@dimen/small_margin"
                        android:background="@color/transparent"
                        android:text="Name" />



                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="@color/filterBackground"
                    android:gravity="center_vertical"
                    android:layout_marginLeft="@dimen/add_beneficiary_side_margin"
                    android:layout_marginRight="@dimen/add_beneficiary_side_margin"
                    android:layout_marginTop="@dimen/margin_5dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Agency Name"
                        android:textColor="@color/black_text_color"
                        android:layout_gravity="center_vertical"
                        android:background="@color/transparent"
                        android:textSize="@dimen/text_size_15sp"
                        android:paddingLeft="@dimen/medium_margin"
                        android:paddingRight="@dimen/medium_margin"
                        />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight=".1"
                        android:text=":"
                        android:textColor="@color/dark_blue_color"
                        android:background="@color/transparent"
                        android:fontFamily="@font/museo_regular"
                        android:textSize="@dimen/list_view_name_field_text_size"
                        />

                    <TextView
                        android:id="@+id/agencyNameTv"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.3"
                        android:layout_gravity="center_vertical"
                        android:textColor="@color/dark_blue_color"
                        android:textSize="@dimen/text_size_16sp"
                        android:padding="@dimen/small_margin"
                        android:background="@color/transparent"
                        android:text="Agency" />



                </LinearLayout>

                <TextView
                    android:id="@+id/creditAlertMessageTv"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="You have pending due, please credit and continue."
                    android:padding="@dimen/margin_10dp"
                    android:gravity="center"
                    android:textSize="@dimen/text_size_15sp"
                    android:background="@color/train_dashboard5"
                    android:textColor="@color/train_dashboard555"
                    android:fontFamily="@font/raleway_semi_bold"
                    android:layout_marginLeft="@dimen/add_beneficiary_side_margin"
                    android:layout_marginRight="@dimen/add_beneficiary_side_margin"
                    android:layout_marginTop="@dimen/margin_7dp"
                    />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="@color/filterBackground"
                    android:gravity="center_vertical"
                    android:layout_marginLeft="@dimen/add_beneficiary_side_margin"
                    android:layout_marginRight="@dimen/add_beneficiary_side_margin"
                    android:layout_marginTop="@dimen/margin_5dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Max Approved Limit"
                        android:textColor="@color/black_text_color"
                        android:layout_gravity="center_vertical"
                        android:background="@color/transparent"
                        android:textSize="@dimen/text_size_15sp"
                        android:paddingLeft="@dimen/medium_margin"
                        android:paddingRight="@dimen/medium_margin"
                        />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight=".1"
                        android:text=":"
                        android:textColor="@color/dark_blue_color"
                        android:background="@color/transparent"
                        android:fontFamily="@font/museo_regular"
                        android:textSize="@dimen/list_view_name_field_text_size"
                        />

                    <TextView
                        android:id="@+id/maxCreditLimitTv"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_gravity="center_vertical"
                        android:textColor="@color/dark_blue_color"
                        android:textSize="@dimen/text_size_16sp"
                        android:padding="@dimen/small_margin"
                        android:background="@color/transparent"
                        android:text="Agency" />



                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="@color/filterBackground"
                    android:gravity="center_vertical"
                    android:layout_marginLeft="@dimen/add_beneficiary_side_margin"
                    android:layout_marginRight="@dimen/add_beneficiary_side_margin"
                    >

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Available Credit"
                        android:textColor="@color/black_text_color"
                        android:layout_gravity="center_vertical"
                        android:background="@color/transparent"
                        android:textSize="@dimen/text_size_15sp"
                        android:paddingLeft="@dimen/medium_margin"
                        android:paddingRight="@dimen/medium_margin"
                        />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight=".1"
                        android:text=":"
                        android:textColor="@color/dark_blue_color"
                        android:background="@color/transparent"
                        android:fontFamily="@font/museo_regular"
                        android:textSize="@dimen/list_view_name_field_text_size"
                        />

                    <TextView
                        android:id="@+id/availableLimitTv"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_gravity="center_vertical"
                        android:textColor="@color/dark_blue_color"
                        android:textSize="@dimen/text_size_16sp"
                        android:padding="@dimen/small_margin"
                        android:background="@color/transparent"
                        android:text="Agency" />



                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="@color/filterBackground"
                    android:gravity="center_vertical"
                    android:layout_marginLeft="@dimen/add_beneficiary_side_margin"
                    android:layout_marginRight="@dimen/add_beneficiary_side_margin"
                    >

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Statement Balance"
                        android:textColor="@color/black_text_color"
                        android:layout_gravity="center_vertical"
                        android:background="@color/transparent"
                        android:textSize="@dimen/text_size_15sp"
                        android:paddingLeft="@dimen/medium_margin"
                        android:paddingRight="@dimen/medium_margin"
                        />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight=".1"
                        android:text=":"
                        android:textColor="@color/dark_blue_color"
                        android:background="@color/transparent"
                        android:fontFamily="@font/museo_regular"
                        android:textSize="@dimen/list_view_name_field_text_size"
                        />

                    <TextView
                        android:id="@+id/balanceTv"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_gravity="center_vertical"
                        android:textColor="@color/dark_blue_color"
                        android:textSize="@dimen/text_size_16sp"
                        android:padding="@dimen/small_margin"
                        android:background="@color/transparent"
                        android:text="Agency" />



                </LinearLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/amount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/add_beneficiary_side_margin"
                    android:layout_marginRight="@dimen/add_beneficiary_side_margin"
                    android:layout_marginTop="@dimen/margin_10dp">

                    <EditText
                        android:id="@+id/amountEdt"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:hint="Credit Amount"
                        android:inputType="number"
                        android:maxLength="5"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:textColor="@color/app_blue_color"
                        android:textColorHint="@color/registration_hint_color"
                        android:textSize="@dimen/money_transfer_input_text_size" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/remarks"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/add_beneficiary_side_margin"
                    android:layout_marginRight="@dimen/add_beneficiary_side_margin"
                    android:layout_marginTop="@dimen/small_margin">

                    <EditText
                        android:id="@+id/remarksEdt"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:digits="@string/personName_editText_digits"
                        android:hint="Enter remarks"
                        android:maxLength="@integer/nameMaxLength"
                        android:singleLine="true"
                        android:text=""
                        android:textColor="@color/app_blue_color"
                        android:textSize="@dimen/money_transfer_input_text_size" />
                </com.google.android.material.textfield.TextInputLayout>


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="bottom"
                    android:orientation="horizontal"
                    android:layout_marginTop="@dimen/large_margin">

                    <TextView
                        android:id="@+id/cancelTv"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginLeft="@dimen/add_beneficiary_side_margin"
                        android:layout_marginRight="@dimen/add_beneficiary_side_margin"
                        android:background="@drawable/app_red_round5_button_background"
                        android:gravity="center"
                        android:paddingLeft="@dimen/small_margin"
                        android:paddingRight="@dimen/small_margin"
                        android:paddingTop="@dimen/medium_margin"
                        android:paddingBottom="@dimen/medium_margin"
                        android:text="Cancel"
                        android:maxLines="1"
                        android:textSize="@dimen/text_size_16sp"
                        android:textColor="@color/color_white" />

                    <TextView
                        android:id="@+id/submitTv"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginLeft="@dimen/add_beneficiary_side_margin"
                        android:layout_marginRight="@dimen/add_beneficiary_side_margin"
                        android:background="@drawable/app_blue_round_button_background"
                        android:gravity="center"
                        android:paddingLeft="@dimen/small_margin"
                        android:paddingRight="@dimen/small_margin"
                        android:paddingTop="@dimen/medium_margin"
                        android:paddingBottom="@dimen/medium_margin"
                        android:text="Submit"
                        android:maxLines="1"
                        android:visibility="visible"
                        android:textSize="@dimen/text_size_16sp"
                        android:textColor="@color/color_white" />


                </LinearLayout>

            </LinearLayout>

        </androidx.cardview.widget.CardView>
    </ScrollView>
</LinearLayout>
