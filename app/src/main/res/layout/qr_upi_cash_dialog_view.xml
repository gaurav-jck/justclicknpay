<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:id="@+id/forgotImageRel"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/border_with_light_background"
    android:layout_gravity="center_horizontal"
    xmlns:android="http://schemas.android.com/apk/res/android">

    <ImageView
        android:id="@+id/qrImg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_marginLeft="@dimen/margin_50dp"
        android:layout_marginRight="@dimen/margin_50dp"
        android:layout_marginTop="@dimen/size_15dp"
        android:src="@drawable/ic_qr_code" />

    <TextView
        android:id="@+id/messageTv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/qrImg"
        android:gravity="center"
        android:text="Payable Amount 100"
        android:layout_marginTop="@dimen/margin_10dp"
        android:textColor="@color/app_blue_color"
        android:textSize="16sp"
        android:textStyle="bold"
        android:padding="@dimen/margin_10dp"/>

    <TextView
        android:id="@+id/okTv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="OK"
        android:textSize="@dimen/_16sdp"
        android:textColor="@color/white"
        android:background="@color/app_blue_color"
        android:layout_below="@id/messageTv"
        android:textStyle="bold"
        android:gravity="center"
        android:padding="@dimen/margin_7dp"
        android:layout_marginTop="@dimen/size_15dp"
        />

</RelativeLayout>